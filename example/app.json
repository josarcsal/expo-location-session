{
  "expo": {
    "name": "expo-location-session-example",
    "slug": "expo-location-session-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.josarcsal.locationsessionexample"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.josarcsal.locationsessionexample"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "newArchEnabled": true,
    "scheme": "locationsession",
    "plugins": [
      [
        "expo-location-session",
        {
          "locationWhenInUseText": "Shares your location with the host during an active session.",
          "locationAlwaysText": "Keeps sharing your location during an active session when the app is in the background.",
          "androidNotificationIcon": "./assets/notification-icon.png"
        }
      ],
      "./plugins/with-dev-ca"
    ]
  }
}
