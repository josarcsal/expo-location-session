{
  "name": "expo-location-session",
  "version": "0.1.0-alpha.0",
  "description": "Background location sessions for React Native, uploaded natively",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "git clean -dfX",
    "release": "semantic-release",
    "build": "npm run typecheck && bob build",
    "build:plugin": "tsc -p plugin",
    "codegen": "nitrogen --logLevel=\"debug\" && npm run build && node post-script.js",
    "prepare": "npm run build:plugin"
  },
  "keywords": [
    "react-native",
    "expo-location-session"
  ],
  "files": [
    "src",
    "lib",
    "nitrogen",
    "cpp",
    "nitro.json",
    "android/build.gradle",
    "android/fix-prefab.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/src",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "app.plugin.js",
    "plugin/build",
    "*.podspec",
    "README.md"
  ],
  "repository": "https://github.com/josarcsal/expo-location-session.git",
  "author": "Jose Arciniega",
  "license": "MIT",
  "bugs": "https://github.com/josarcsal/expo-location-session/issues",
  "homepage": "https://github.com/josarcsal/expo-location-session#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@jamesacarr/eslint-formatter-github-actions": "^0.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "expo": "~58.0.26",
    "nitrogen": "0.37.2",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.40.18",
    "react-native-nitro-modules": "0.37.2",
    "semantic-release": "^25.0.7",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.37.0",
    "expo": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "plugins": [
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "warn",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "semi": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  }
}
