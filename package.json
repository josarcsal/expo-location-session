{
  "name": "expo-location-session",
  "version": "0.2.0-beta.1",
  "description": "Background location sessions for React Native, uploaded natively",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "git clean -dfX",
    "build": "npm run typecheck && bob build",
    "build:plugin": "tsc -p plugin",
    "codegen": "nitrogen --logLevel=\"debug\" && npm run build",
    "prepare": "npm run build:plugin",
    "lint": "eslint . && prettier --check \"**/*.{js,mjs,cjs,ts,tsx}\"",
    "format": "eslint --fix . && prettier --write \"**/*.{js,mjs,cjs,ts,tsx}\"",
    "prepack": "npm run build && npm run build:plugin"
  },
  "keywords": [
    "react-native",
    "expo-location-session"
  ],
  "files": [
    "src",
    "lib",
    "nitrogen",
    "cpp",
    "nitro.json",
    "android/build.gradle",
    "android/fix-prefab.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/consumer-rules.pro",
    "android/src",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "app.plugin.js",
    "plugin/build",
    "*.podspec",
    "README.md",
    "!android/src/test",
    "!ios/Core/Tests",
    "!ios/Core/Package.swift",
    "!ios/Core/.build"
  ],
  "repository": "https://github.com/josarcsal/expo-location-session.git",
  "author": "Jose Arciniega",
  "license": "MIT",
  "bugs": "https://github.com/josarcsal/expo-location-session/issues",
  "homepage": "https://github.com/josarcsal/expo-location-session#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.14.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-native": "5.0.0",
    "expo": "~58.0.26",
    "nitrogen": "0.37.2",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.40.18",
    "react-native-nitro-modules": "0.37.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.37.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
